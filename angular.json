{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "commercial-reservation-portal": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": {
            "production": { "target": "commercial-reservation-portal:esbuild:production" },
            "development": { "target": "commercial-reservation-portal:esbuild:development", "dev": true }
          },
          "defaultConfiguration": "production"
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/commercial-reservation-portal",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["es-module-shims"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": []
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": { "target": "commercial-reservation-portal:serve-original:development", "rebuildDelay": 0, "dev": true, "port": 4201 }
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "configurations": { "development": { "buildTarget": "commercial-reservation-portal:esbuild:development" } },
          "defaultConfiguration": "development",
          "options": { "port": 4201 }
        },
        "module": {
          "builder": "@angular/build:application",
          "options": { "browser": "src/mount-entry.ts", "index": false, "outputPath": "dist/module", "tsConfig": "tsconfig.module.json", "outputHashing": "none", "styles": [],
            "budgets": [{ "type": "initial", "maximumWarning": "650kb", "maximumError": "700kb" }] },
          "configurations": {
            "demo": { "fileReplacements": [{ "replace": "src/app/sources.ts", "with": "src/app/sources.demo.ts" }] }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "commercial-reservation-portal:esbuild:development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "include": ["../tests/**/*.spec.ts"]
          }
        }
      }
    }
  }
}
